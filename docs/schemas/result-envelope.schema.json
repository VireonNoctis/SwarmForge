{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VireonNoctis/SwarmForge/main/docs/schemas/result-envelope.schema.json",
  "title": "SwarmForge task result envelope",
  "description": "Portable structural contract for a task result. Correlation, producer identity, slot matching, and acceptance completeness require coordinator-side semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "task_id",
    "task_spec_revision",
    "attempt_id",
    "dispatch_registry_revision",
    "worker_session_id",
    "terminal_state",
    "result_completeness",
    "summary",
    "artifacts",
    "acceptance_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "dispatch_registry_revision": {
      "type": "integer",
      "minimum": 1
    },
    "worker_session_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identifier"
        }
      ]
    },
    "terminal_state": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/non_empty"
        }
      ]
    },
    "result_completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "summary": {
      "$ref": "#/$defs/non_empty"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance_evidence"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "maxLength": 256
    },
    "non_empty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "slot_id",
        "producer_task_id",
        "producer_attempt_id",
        "locator",
        "immutable_ref",
        "byte_length",
        "content_digest",
        "acceptance_criteria_ids"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "slot_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_task_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_attempt_id": {
          "$ref": "#/$defs/identifier"
        },
        "locator": {
          "$ref": "#/$defs/non_empty"
        },
        "immutable_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/non_empty"
            }
          ]
        },
        "byte_length": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha-256"
            },
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              ]
            }
          }
        },
        "acceptance_criteria_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "artifact_ids",
        "evidence_ref",
        "verification_command"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "evidence_ref": {
          "$ref": "#/$defs/non_empty"
        },
        "verification_command": {
          "$ref": "#/$defs/non_empty"
        }
      }
    }
  }
}
